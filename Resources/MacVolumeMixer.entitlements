<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime resource access for audio input. Process taps are an audio-input
	     path; this is kept so Developer ID (hardened runtime) builds are not blocked. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
